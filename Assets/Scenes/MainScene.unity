  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "ok. 1572 r. \u2013 Opuszczenie miasta\nPo upadku ostatniego inkaskiego
    bastionu w Vilcabambie i hiszpa\u0144skim podboju, Machu Picchu zosta\u0142o
    opuszczone przez mieszka\u0144c\xF3w.\nHiszpanie nigdy nie dotarli do Machu Picchu,
    dzi\u0119ki czemu miasto nie zosta\u0142o spl\u0105drowane ani zniszczone.\nPrzez
    ponad 300 lat pozostawa\u0142o niemal ca\u0142kowicie zapomniane i ukryte w d\u017Cungli."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
