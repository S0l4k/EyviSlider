  ingridients:
  - {fileID: 550340434}
  - {fileID: 251002863}
  - {fileID: 1356320588}
  - {fileID: 1952644045}
  textBox: {fileID: 1226683695}
  textUI: {fileID: 2015237902}
  greatingText: "Bonjour mon ami I\u2019m the local baker, and I was just about to
    bake some baguettes, but I\u2019m missing a few ingredients. Would you like to
    help me? You would? That\u2019s wonderful! Unfortunately, our delivery got scattered
    all over Paris... I need flour, yeast, water, and salt. Bonne chance!"
  missingIngridients: "You're still missing a few ingredients \u2014 come back once
    you've gathered them all."
  allIngridients: "You did it! Now I can start baking \u2014 just give me a moment...
    - voil\xE0 Here it is \u2014 our famous baguette! Thank you, my friend. Please,
    stay in Paris a little longer, look around, and find yourself a place to stay.Au
    revoir!"
  finishedMigiame: Merci Beaucoup!
  ingridientsCount: 0
